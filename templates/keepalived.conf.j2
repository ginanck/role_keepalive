{{ ansible_managed | comment }}

{% if keepalive__vrrp_script is defined %}
    {% for item in keepalive__vrrp_script %}
vrrp_script {{ item.vrrp_script }} { 
    script "{{ item.script }}"
    interval {{ item.interval }}
    weight {{ item.weight }}
}
    {% endfor %}
{% endif %}

{% if keepalive__instances is defined %}
    {% for item in keepalive__instances %}
vrrp_instance {{ item.name }} {
    interface {{ item.interface }}
    state {{ item.state }}
    priority {{ item.priority }}
    virtual_router_id {{ item.virtual_router_id }}

    authentication {
        auth_type {{ item.authentication.auth_type }}
        auth_pass {{ item.authentication.auth_pass }}
    }

    unicast_src_ip {{ item.unicast_src_ip }} # Private IP address of master
    unicast_peer {
        {% for item in item.unicast_peer %}
        {{ item }} # Private IP address of the backup server
        {% endfor %}
   }

    # The virtual ip address shared between the three loadbalancers
    virtual_ipaddress {
        {% for item in item.virtual_ipaddress %}
        {{ item }} # Private IP address of the backup server
        {% endfor %}
    }

    # Use the Defined Script to Check whether to initiate a fail over
    track_script {
        {{ item.track_script }}
    }
}
    {% endfor %}
{% endif %}
